{
"version": 2,
"cleanUrls": true,
"rewrites": [
{
"source": "/(.)",
"destination": "/index.html"
}
],
"headers": [
{
"source": "/(.)",
"headers": [
{
"key": "Cache-Control",
"value": "public, max-age=86400, must-revalidate"
},{"key": "X-Content-Type-Options","value": "nosniff"
}
]
}
]
}